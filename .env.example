# Used by docker-compose.yml when running `docker compose up`.
# Copy to .env and fill in real secrets before deploying anywhere shared.

CLIENT_ORIGIN=http://localhost:8080

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# Bootstrap Admin account created by the idempotent seed script.
SEED_ADMIN_EMAIL=admin@innocito.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# Set to "false" after the first successful boot if you don't want the
# (idempotent, safe-to-rerun) seed script running on every container start.
RUN_SEED_ON_BOOT=true
