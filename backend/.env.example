# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innocito_crm?schema=public

# Redis (caching, rate-limit store)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap admin (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@innocito.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Logging
LOG_LEVEL=info
