# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innocito_crm?schema=public

# Redis (caching, rate-limit store)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap admin (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@innocito.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Logging
LOG_LEVEL=info

# Outbound email (optional) — powers real delivery of lead assignment, status change, task, and
# other system notifications to each user's current Email ID. Leave SMTP_HOST unset to keep
# running with in-app notifications only (nothing sends, nothing errors) — see utils/emailer.ts.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Innocito CRM <notifications@innocito.com>

# Connected mailboxes (optional) — Phase 9 "sequences" Stage 1. Lets a user connect their own
# Google or Microsoft mailbox so sequence/system emails go out as them; SMTP above stays the
# fallback when unset or when a user hasn't connected anything. Both providers stay "unconfigured"
# (disabled in Settings > Connected Accounts) until their three vars below are all set, exactly
# like SMTP_HOST above gates email delivery. TOKEN_ENCRYPTION_KEY gates BOTH providers together —
# generate one with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-backend-domain/api/integrations/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=https://your-backend-domain/api/integrations/microsoft/callback
#
# Calendar sync (Phase 9 "sequences" Stage 3) reuses these same six vars — no new env vars were
# introduced. Stage 3 only bumps the requested OAuth `scope` for both providers (adds
# calendar.events / Calendars.ReadWrite) inside integrations.service.ts; anyone who connected
# before Stage 3 shipped needs to reconnect once from Settings > Connected Accounts to pick up the
# new scope (see hasCalendarScope() / calendarScopeGranted). No config action needed here.

# Sequences engine (optional, all have working defaults) — Phase 9 "sequences" Stage 2. The
# in-process scheduler checks for due sequence steps every SEQUENCE_SCHEDULER_INTERVAL_MINUTES and
# only sends between the window's start/end hour (UTC — see env.ts's comment on why this is a
# single global window rather than per-organization).
# SEQUENCE_SEND_WINDOW_START_HOUR=9
# SEQUENCE_SEND_WINDOW_END_HOUR=18
# SEQUENCE_SCHEDULER_INTERVAL_MINUTES=5
