server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Resolve the backend hostname at REQUEST time rather than once at nginx
    # startup. Without this, a bare `proxy_pass http://host:port/;` caches the
    # resolved IP for the lifetime of the worker process — so when the backend
    # container restarts/redeploys and gets a new internal address (Docker
    # Compose service restart, Railway redeploy, etc.), nginx keeps sending
    # traffic to the old, now-dead IP and every request hangs until nginx
    # itself is restarted. `resolver local=on` reads nameservers from the
    # container's own /etc/resolv.conf (Docker's embedded DNS at 127.0.0.11
    # for Compose, Railway's private-network resolver for Railway) so this
    # works unmodified in both environments; storing the origin in a variable
    # is what forces per-request re-resolution instead of load-time caching.
    resolver local=on valid=10s;

    # Proxy API calls to the backend service. BACKEND_ORIGIN is substituted at
    # container start (via envsubst — see the nginx:alpine entrypoint's
    # templates mechanism) so the same image works against Docker Compose's
    # service-name DNS ("backend") or Railway's private-network hostname
    # ("<service>.railway.internal") without a rebuild.
    location /api/ {
        set $backend_origin ${BACKEND_ORIGIN};
        proxy_pass $backend_origin/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    location /uploads/ {
        set $backend_origin ${BACKEND_ORIGIN};
        proxy_pass $backend_origin/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Cache hashed static assets aggressively.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback — client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
